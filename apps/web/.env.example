# The Blue Red - Teklif Asistani Web Admin (React + Vite)
# Vite yalnizca VITE_ ile baslayan degiskenleri tarayici paketine koyar.
# Buraya ASLA private API anahtari yazma; bu degerler herkese acik bundle'a girer.

# Backend adresi (dev: localhost; compose icinde ayrica ayarlanir)
VITE_API_BASE_URL=http://localhost:8000

# Acik quote gorunumu icin yenileme araligi (ms). Sirket sarti degil, demo tercihi.
VITE_QUOTE_POLL_INTERVAL_MS=2500
