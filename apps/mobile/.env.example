# The Blue Red - Teklif Asistani Mobil (Expo)
# EXPO_PUBLIC_ ile baslayan her deger istemci paketine gomulur ve herkese aciktir.
# Buraya ASLA OPENAI_API_KEY veya baska private anahtar yazma. LLM anahtari yalnizca backend'dedir.

# Fiziksel telefonda "localhost" telefonun kendisidir; Mac'in LAN adresini yaz (ornek: http://192.168.1.20:8000).
# Gercek IP'yi bu ornek dosyaya degil, .env dosyasina yaz.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Demo baglami: hazir musteri/teklif secimi uygulama icinden yapilir; buraya sabitleme.
