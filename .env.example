# The Blue Red - Teklif Asistani (monorepo kok .env; Docker Compose ve apps/api bunu okur)
# Bu dosya yalnizca PLACEHOLDER icerir. Gercek degerleri .env dosyasina yaz; .env asla commit edilmez.
# Web ve mobil istemcilerin kendi ornekleri: apps/web/.env.example, apps/mobile/.env.example

# --- PostgreSQL (compose "db" servisi) ---
POSTGRES_DB=tbr_quotes
POSTGRES_USER=tbr
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://tbr:change-me-local-only@db:5432/tbr_quotes
# Testler ayri veritabani kullanir; demo verisini silmez
TEST_DATABASE_URL=postgresql+asyncpg://tbr:change-me-local-only@db:5432/tbr_quotes_test

# --- API ---
API_BIND_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# --- LLM (opsiyonel; bos = deterministik fallback modu, provider hic cagrilmaz) ---
OPENAI_API_KEY=
LLM_MODE=off
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15

# --- Seed (JSON'dan idempotent import; restart kullanici degisikliklerini silmez) ---
SEED_SOURCE_DIR=/app/data/source
SEED_ON_STARTUP=true

# --- Web (compose icindeki web build'i icin) ---
VITE_API_BASE_URL=http://localhost:8000
