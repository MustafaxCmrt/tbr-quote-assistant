# Generate ignored .env with: python3 scripts/init_env.py
# Keep these two secrets on the server; never put them in VITE_/EXPO_PUBLIC_ variables.
POSTGRES_PASSWORD=replace-with-random-owner-password
APP_DB_PASSWORD=replace-with-random-runtime-password
# Loopback by default. For a trusted LAN mobile test set 0.0.0.0 deliberately.
API_BIND_HOST=127.0.0.1
API_PORT=8001
WEB_PORT=5173
DEBUG_STREAM_SMOKE=0
# Optional future provider integration; unused during F01.
OPENAI_API_KEY=
LLM_MODE=off
