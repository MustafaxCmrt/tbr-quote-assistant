{
  "name": "tbr-quote-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "test": "tsx --test packages/contracts/tests/*.test.ts apps/mobile/tests/*.test.ts apps/web/tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps/mobile packages/contracts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
